  {
    "name": "DANE corrected wrapped input history with XLS precision",
    "route": "/insumo/10-20-20-50-kilogramos?department=Antioquia&scope=municipality&municipality=El+Carmen+de+Viboral&history=all",
    "ready": "document.querySelectorAll('.chart-data tbody tr').length>100",
    "steps": [
      {
        "action": "document.querySelector('.chart-data').open=true;window.__qaInputSource=await fetch(\"/api/explore/input?id=10-20-20-50-kilogramos&department=Antioquia&scope=municipality&municipality=El+Carmen+de+Viboral&history=all\").then(r=>{if(!r.ok)throw Error('Input oracle HTTP '+r.status);return r.json()});",
        "checks": [
          {
            "id": "INP-09",
            "condition": "[...document.querySelectorAll('.chart-data tbody tr')].some(r=>r.cells[0].textContent===new Date('2012-07-31T12:00:00Z').toLocaleDateString('es-CO',{day:'numeric',month:'long',year:'numeric',timeZone:'America/Bogota'})&&Number(r.cells[1].textContent.replace(/[^0-9]/g,''))===82833)",
            "expected": "Historical July2012 El Carmen price82833 matches independent native original"
          },
          {
            "id": "INP-09",
            "condition": "[...document.querySelectorAll('.chart-data tbody tr')].some(r=>r.cells[0].textContent===new Date('2015-12-31T12:00:00Z').toLocaleDateString('es-CO',{day:'numeric',month:'long',year:'numeric',timeZone:'America/Bogota'})&&Number(r.cells[1].textContent.replace(/[^0-9]/g,''))===92417)",
            "expected": "UI December2015 correctly formats more precise XLS92,416.6667 as92,417"
          },
          {
            "id": "INP-04",
            "condition": "document.querySelector('.applied-filters').textContent.includes('El Carmen de Viboral')&&document.querySelector('.applied-filters').textContent.includes('50 kilogramos')&&document.querySelector('.applied-filters').textContent.includes('Todo el historial')",
            "expected": "Full municipality, original package and all-history scope visible"
          },
          {
            "id": "INP-04",
            "condition": "!window.__qaInputSource.regions.some(r=>r.municipality==='de Viboral')&&![...document.querySelectorAll('option')].some(r=>r.textContent.trim()==='de Viboral, Antioquia')",
            "expected": "Obsolete truncated PDF municipality is absent from published choices"
          },
          {
            "id": "INP-09",
            "condition": "window.__qaInputSource.history.find(r=>r.date==='2015-12-31')?.price===92416.66666666667",
            "expected": "Newer XLS raw precision remains intact beneath UI rounded price",
            "observed": "window.__qaInputSource.history.find(r=>r.date==='2015-12-31')"
          }
        ]
      }
    ]
