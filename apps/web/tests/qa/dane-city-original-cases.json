[
  {
    "name": "DANE original PDF page1 banano-criollo 1kg",
    "route": "/product/banano-criollo?region=Atl%C3%A1ntico&series=city&presentation=Kilogramo&units=1+Kilogramo&market=sipsa-barranquilla-barranquillita&history=all",
    "ready": "!!document.querySelector(\".price-chart\") && !document.querySelector(\"[role=alert]\")",
    "steps": [
      {
        "checks": [
          {
            "id": "PRD-01",
            "condition": "Number((document.querySelector(\"[data-testid=current-product-price]\")?.innerText||\"\").replace(/[^0-9]/g,\"\"))===1440",
            "expected": "COP 1440 midpoint of manually read original range 1440–1440, page 1"
          },
          {
            "id": "PRD-02",
            "condition": "(document.querySelector(\".product-price-header\")?.innerText||\"\").includes(\"Kilogramo\") && (document.querySelector(\".product-price-header\")?.innerText||\"\").includes(\"1 Kilogramo\")",
            "expected": "Exact original presentation and quantity"
          },
          {
            "id": "PRD-05",
            "condition": "document.querySelector(\".detail-intro .eyebrow\")?.innerText===\"Frutas > Otras frutas\"",
            "expected": "Full current selected source classification"
          },
          {
            "id": "PRD-04",
            "condition": "(document.querySelector(\".applied-filters\")?.innerText||\"\").includes(\"Barranquilla, Barranquillita\") && (document.querySelector(\".applied-filters\")?.innerText||\"\").includes(\"1 Kilogramo\")",
            "expected": "Market and units always visible"
          },
          {
            "id": "EVI-01",
            "condition": "Array.from(document.querySelectorAll(\"a.evidence-link\")).some(a=>a.href.includes(\"6f6427903f2879d35e6032601f4cdc1e4ef7b66cb8648155b2353a0a6c55ac30\"))",
            "expected": "Exact archived Sep25 member PDF reachable"
          }
        ]
      },
      {
        "action": "document.querySelector(\".chart-data\").open=true;",
        "checks": [
          {
            "id": "PRD-08",
            "condition": "(()=>{const v=Array.from(document.querySelectorAll(\".chart-data tbody tr\"),r=>Number(r.cells[1].innerText.replace(/[^0-9]/g,\"\")));return v.length>0&&v.every((p,i)=>i===0||v[i-1]>=p)})()",
            "expected": "History table is descending by price"
          },
          {
            "id": "PRD-08",
            "condition": "Array.from(document.querySelectorAll(\".chart-data tbody tr\")).some(r=>r.cells[0].innerText===new Date(\"2026-09-25T12:00:00Z\").toLocaleDateString(\"es-CO\",{day:\"numeric\",month:\"long\",year:\"numeric\",timeZone:\"America/Bogota\"}) && Number(r.cells[1].innerText.replace(/[^0-9]/g,\"\"))===1440)",
            "expected": "Exact source-date package midpoint present in history"
          }
        ]
      }
    ]
  },
