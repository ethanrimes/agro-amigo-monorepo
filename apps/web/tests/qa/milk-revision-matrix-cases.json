  {
    "name": "DANE milk original review ubate-villapinzon",
    "route": "/evidence/7bdeb21148f0ae14ef55259f30cd7f4806689bd67a149e4ccff59de226057343?page=6",
    "ready": "!!document.querySelector('canvas[data-rendered=true]')&&!!document.querySelector('.pdf-text')",
    "steps": [
      {
        "action": "document.querySelector('.pdf-text').closest('details').open=true;",
        "checks": [
          {
            "id": "EVI-17",
            "condition": "document.querySelector('.evidence-heading').textContent.includes('identidad de mercado incorrecta')&&document.querySelector('.evidence-heading').textContent.includes('no se usan como precios publicados')",
            "expected": "Original viewer explains prior invalid market identities are retained and excluded from published prices"
          },
          {
            "id": "EVI-03",
            "condition": "document.querySelector('select[aria-label=\"Página del documento\"]').value==='6'&&!!document.querySelector('canvas[data-rendered=true]')",
            "expected": "Exact audited native page renders"
          },
          {
            "id": "EVI-03",
            "condition": "(()=>{const t=document.querySelector('.pdf-text').textContent;return t.includes(\"San Diego de Ubaté\")&&t.includes(\"Villapinzón\")&&t.includes(\"1.976\")&&t.includes(\"1.680\")})()",
            "expected": "Literal original municipality fragments and prices remain visible; source text is not rewritten"
          },
          {
            "id": "EVI-16",
            "condition": "document.querySelector('.evidence-actions a[download]')?.getAttribute('href')==='/api/evidence/7bdeb21148f0ae14ef55259f30cd7f4806689bd67a149e4ccff59de226057343/content'",
            "expected": "Download targets exact immutable audited PDF SHA"
          },
          {
            "id": "EVI-10",
            "condition": "document.documentElement.scrollWidth<=innerWidth+1",
            "expected": "Review note and PDF controls remain within viewport"
          }
        ]
      }
    ]
  },
