[
  {
    "name": "DANE milk revised market san-pedro",
    "route": "/product/leche-cruda-en-finca?region=&series=farmgate&presentation=Por+unidad+de+medida&units=1+litro&history=all&market=finca-antioquia-san-pedro-de-los-milagros",
    "ready": "!!document.querySelector('.price-chart')&&document.querySelector('select[aria-label=Mercado]')?.value===\"finca-antioquia-san-pedro-de-los-milagros\"&&!document.querySelector('[role=alert]')",
    "steps": [
      {
        "action": "window.__qaMilk=null;window.__qaMilkError=null;document.querySelector('.chart-data').open=true;fetch('/api/products/leche-cruda-en-finca'+location.search).then(r=>{if(!r.ok)throw new Error('milk '+r.status);return r.json()}).then(x=>window.__qaMilk=x).catch(e=>window.__qaMilkError=String(e));",
        "ready": "!!window.__qaMilk||!!window.__qaMilkError",
        "checks": [
          {
            "id": "PRD-03",
            "condition": "document.querySelector('select[aria-label=Mercado]').value===\"finca-antioquia-san-pedro-de-los-milagros\"&&window.__qaMilk.filters.market===\"finca-antioquia-san-pedro-de-los-milagros\"&&window.__qaMilk.filters.history==='all'",
            "expected": "Corrected municipality stays selected across current price and all-history data"
          },
          {
            "id": "PRD-06",
            "condition": "document.querySelector('select[aria-label=Unidades]').value==='1 litro'&&window.__qaMilk.filters.series==='farmgate'&&document.querySelector('.product-price-header').textContent.includes('1 litro')",
            "expected": "Original farmgate milk remains COP per litre"
          },
          {
            "id": "PRD-01",
            "condition": "Number(document.querySelector('[data-testid=current-product-price]').textContent.replace(/[^0-9]/g,''))===Math.round(Number(window.__qaMilk.current.price))",
            "expected": "Top price equals exact eligible current API value rounded only for display; no fixed latest date"
          },
          {
            "id": "PRD-09",
            "condition": "(()=>{const day=\"2018-12-31\";const p=window.__qaMilk.history.find(x=>x.date===day);const label=new Date(day+'T12:00:00Z').toLocaleDateString('es-CO',{day:'numeric',month:'long',year:'numeric',timeZone:'America/Bogota'});const tr=Array.from(document.querySelectorAll('.chart-data tbody tr')).find(r=>r.children[0].textContent===label);return p&&Math.abs(Number(p.price)-1077)<1&&tr&&Number(tr.children[1].textContent.replace(/[^0-9]/g,''))===Math.round(Number(p.price))})()",
            "expected": "Historic 2018-12-31 belongs to corrected market; nativePDF prints 1077COP/litre (preferred XLS may retain sub-peso precision), displayed table exactly matches eligible API"
          },
          {
            "id": "PRD-05",
            "condition": "(()=>{const bad=[\"finca-cundinamarca-san-diego-de-ubate-villapinzon\", \"finca-cundinamarca-de-ubate-villapinzon\", \"finca-cundinamarca-ubate-villapinzon\", \"finca-antioquia-san-pedro-de-los-mi\", \"finca-bolivar-xx-magangue\"];return !Array.from(document.querySelectorAll('select[aria-label=Mercado] option')).some(x=>bad.includes(x.value))&&!window.__qaMilk.options.markets.some(x=>bad.includes(x.id))})()",
            "expected": "Five independently proved malformed historical market identities absent from both selector and published API options"
          }
        ]
      }
    ]
  },
