        $("#" + tmp01.htmlObject).hide();
        $("#" + tmp02.htmlObject).show();
        tmp02.htmlObject = 'grl01';
        tmpbtn.chartExportComponent = 'gr02def';
     
    }
    Dashboards.setParameter('graficaActiva', Dashboards.getParameterValue('parsPrecio'));
